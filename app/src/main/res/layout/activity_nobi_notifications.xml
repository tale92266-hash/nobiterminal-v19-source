<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nobiNotificationsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/nobi_notifications_title"
        app:navigationIcon="@drawable/nobi_ic_arrow_back" />

    <!-- Empty state: shown when access is off, or when nothing arrived yet. -->
    <LinearLayout
        android:id="@+id/nobiNotificationsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/nobi_ic_bell" />

        <TextView
            android:id="@+id/nobiNotificationsEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/nobi_notifications_empty_no_access"
            android:textSize="15sp" />

        <Button
            android:id="@+id/nobiNotificationsGrantButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nobi_notifications_grant" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/nobiNotificationsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/nobiNotificationsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nobi_notifications_showing_latest"
            android:textSize="13sp" />

        <Button
            android:id="@+id/nobiNotificationsClearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nobi_notifications_clear" />
    </LinearLayout>

</LinearLayout>
