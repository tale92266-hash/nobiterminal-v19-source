<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="46dp"
    android:orientation="vertical">

    <!-- Active tab indicator (VS Code style top bar) -->
    <View
        android:id="@+id/tabIndicator"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_tab_indicator"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/tabIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tabTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxWidth="140dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />

        <!-- Unsaved-changes dot (shows alongside × when modified) -->
        <View
            android:id="@+id/tabModifiedDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/tabPin"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_pin"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/tabClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/cd_close" />

    </LinearLayout>

</LinearLayout>
