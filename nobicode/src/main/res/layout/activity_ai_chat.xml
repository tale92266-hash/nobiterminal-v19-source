<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/aiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/aiSetupBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/aiEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Endpoint (OpenAI-compatible base URL)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/aiModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model" />

        <EditText
            android:id="@+id/aiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API key (optional for local servers)"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/aiSaveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save provider" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/aiList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/aiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ask about your code…" />

        <Button
            android:id="@+id/aiSendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send" />
    </LinearLayout>
</LinearLayout>
