<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NobiCode" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="android:statusBarColor">@color/surface_container_low</item>
        <item name="android:navigationBarColor">@color/surface_container_low</item>
    </style>

    <!-- v16: DayNight twin of Theme.NobiCode, used ONLY by SettingsActivity.
         Light mode intentionally carries no color items (stock Material3
         light palette); the night override in values-night/themes.xml
         repeats Theme.NobiCode's dark items, so dark mode looks exactly as
         it did before. Other activities keep fixed-dark Theme.NobiCode, and
         no color value was invented for this. -->
    <style name="Theme.NobiCode.DayNight" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Fullscreen terminal theme - no status bar like Termux -->
    <style name="Theme.Terminal.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
