    <item
        android:id="@+id/action_goto"
        android:title="@string/action_goto"
        app:showAsAction="never" />

    <!-- v6 (11): list of functions in the file, tap to jump. -->
    <item
        android:id="@+id/action_outline"
        android:title="Code Outline"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_markdown_preview"
        android:title="@string/action_markdown_preview"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_settings"
        android:title="@string/action_settings"
        app:showAsAction="never" />
